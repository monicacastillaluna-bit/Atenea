# Este archivo es solo un modelo. Tus claves reales van en el archivo .env de tu
# CARPETA DE DATOS (por defecto C:\Users\<usuario>\Atenea-datos\.env), que la app crea
# sola la primera vez. Ahí no lo tocan las actualizaciones. Desde la app:
# Ajustes → Abrir carpeta de datos.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# FIREBASE_SERVICE_ACCOUNT=C:\Users\Lenovo\secrets\athenea-firebase-adminsdk.json

# Opcionales
# PORT=5180
# ATENEA_DATOS=D:\otra\carpeta\de\datos
