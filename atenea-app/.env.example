# Copia este archivo como ".env" (en esta misma carpeta) y completa lo que uses.
# El archivo .env NO se sube al repositorio: las claves nunca salen de tu computador.

# Motor de IA (elige el proveedor en la app: Ajustes → Motor de IA). Basta con uno.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

